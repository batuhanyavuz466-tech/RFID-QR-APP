# Kopyala: cp .env.example .env  (ya da bu degiskenleri sunucu ortaminda tanimla)

# Sunucu portu (Render/VPS genelde kendi PORT'unu verir)
PORT=3000

# Yonetim paneli anahtari - CANLIYA ALMADAN MUTLAKA guclu/rastgele bir deger ile degistir
ADMIN_KEY=change-me

# QR uretirken kullanilacak alan adi (scripts/qr-uret.js icin)
BASE_URL=https://deger.markamiz.com

# restoranlar.json ve yedekler/ klasorunun tutulacagi dizin.
# Bos birakilirsa proje klasorunun icinde tutulur (repo ile ayni yer - kalici disk DEGIL).
# Render'da: Persistent Disk mount noktasini buraya ver (ornek: /data)
DATA_DIR=
